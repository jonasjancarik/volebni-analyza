{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "volebni-analyza-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "--app-dir",
        "src",
        "web_api:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8600"
      ],
      "port": 8600
    },
    {
      "name": "volebni-analyza-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5180
    }
  ]
}
